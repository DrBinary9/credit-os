<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Credit-OS | Compliance Rules</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="app-body">
    <%- include('../partials/nav', { activePage: 'compliance' }) %>

        <div class="admin-layout">
            <div class="page-header">
                <div>
                    <h1 class="page-title">Compliance Guidelines</h1>
                    <p class="page-sub">RBI KYC / PMLA / AML Compliance Table — <strong>
                            <%= items.length %>
                        </strong> records</p>
                </div>
                <button class="btn-primary" onclick="toggleForm()">+ Add New</button>
            </div>

            <% if (error) { %>
                <div class="alert alert-error"><span>⚠</span>
                    <%= error %>
                </div>
                <% } %>

                    <!-- ADD / EDIT FORM -->
                    <div class="form-panel" id="formPanel" style="<%= editItem ? '' : 'display:none' %>">
                        <h2 class="form-panel-title" id="add">
                            <%= editItem ? '✏️ Edit Guideline' : '➕ New Compliance Guideline' %>
                        </h2>
                        <form action="/admin/compliance/save" method="POST" class="crud-form">
                            <div class="form-grid">
                                <div class="form-group">
                                    <label>Guideline ID *</label>
                                    <input type="text" name="guideline_id" placeholder="e.g. CMP-061"
                                        value="<%= editItem ? editItem.guideline_id : '' %>" <%=editItem ? 'readonly'
                                        : '' %> required/>
                                </div>
                                <div class="form-group">
                                    <label>Risk Level *</label>
                                    <select name="risk_level" required>
                                        <% ['High','Medium','Low'].forEach(function(r){ %>
                                            <option value="<%= r %>" <%=editItem &&
                                                editItem.risk_level===r?'selected':'' %>><%= r %>
                                            </option>
                                            <% }) %>
                                    </select>
                                </div>
                                <div class="form-group form-full">
                                    <label>Requirement *</label>
                                    <textarea name="requirement" rows="2"
                                        required><%= editItem ? editItem.requirement : '' %></textarea>
                                </div>
                                <div class="form-group">
                                    <label>Regulation Source</label>
                                    <input type="text" name="regulation_source"
                                        value="<%= editItem ? editItem.regulation_source : '' %>" />
                                </div>
                                <div class="form-group">
                                    <label>Applies To</label>
                                    <input type="text" name="applies_to"
                                        value="<%= editItem ? editItem.applies_to : '' %>" />
                                </div>
                                <div class="form-group">
                                    <label>Mandatory Stage</label>
                                    <select name="mandatory_stage">
                                        <% ['Application','Approval','Disbursement','Monitoring','Governance'].forEach(function(s){
                                            %>
                                            <option value="<%= s %>" <%=editItem &&
                                                editItem.mandatory_stage===s?'selected':'' %>><%= s %>
                                            </option>
                                            <% }) %>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label>Non-Compliance Impact</label>
                                    <input type="text" name="non_compliance_impact"
                                        value="<%= editItem ? editItem.non_compliance_impact : '' %>" />
                                </div>
                                <div class="form-group form-full">
                                    <label>Notes</label>
                                    <input type="text" name="notes" value="<%= editItem ? editItem.notes : '' %>" />
                                </div>
                            </div>
                            <div class="form-actions">
                                <button type="submit" class="btn-primary">
                                    <%= editItem ? '💾 Update' : '✅ Save' %>
                                </button>
                                <a href="/admin/compliance" class="btn-ghost">Cancel</a>
                            </div>
                        </form>
                    </div>

                    <!-- TABLE -->
                    <div class="table-container">
                        <div class="table-toolbar">
                            <input type="text" class="table-search" placeholder="🔍 Search guidelines..."
                                id="tableSearch" oninput="filterTable()" />
                            <span class="table-count" id="tableCount">
                                <%= items.length %> items
                            </span>
                        </div>
                        <div class="table-wrap">
                            <table class="data-table" id="dataTable">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Requirement</th>
                                        <th>Source</th>
                                        <th>Applies To</th>
                                        <th>Stage</th>
                                        <th>Risk</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% items.forEach(function(item){ %>
                                        <tr>
                                            <td><span class="id-badge">
                                                    <%= item.guideline_id %>
                                                </span></td>
                                            <td class="cell-wrap">
                                                <%= item.requirement %>
                                            </td>
                                            <td class="cell-sm text-muted">
                                                <%= item.regulation_source %>
                                            </td>
                                            <td class="cell-sm">
                                                <%= item.applies_to %>
                                            </td>
                                            <td><span class="stage-badge">
                                                    <%= item.mandatory_stage %>
                                                </span></td>
                                            <td>
                                                <span
                                                    class="risk-badge risk-<%= item.risk_level ? item.risk_level.toLowerCase() : 'low' %>">
                                                    <%= item.risk_level %>
                                                </span>
                                            </td>
                                            <td class="cell-actions">
                                                <a href="/admin/compliance/edit/<%= encodeURIComponent(item.guideline_id) %>"
                                                    class="btn-action btn-edit">Edit</a>
                                                <form
                                                    action="/admin/compliance/delete/<%= encodeURIComponent(item.guideline_id) %>"
                                                    method="POST" style="display:inline"
                                                    onsubmit="return confirm('Delete <%= item.guideline_id %>?')">
                                                    <button type="submit" class="btn-action btn-delete">Delete</button>
                                                </form>
                                            </td>
                                        </tr>
                                        <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
        </div>
        <script src="/js/admin.js"></script>
</body>

</html>