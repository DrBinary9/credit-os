<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Credit-OS | Login</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="auth-body">
  <div class="auth-wrapper">
    <div class="auth-card">
      <div class="auth-logo">
        <div class="logo-icon">C+</div>
        <h1>Credit<span class="accent">OS</span></h1>
        <p class="auth-subtitle">Agent-Powered Credit Intelligence Platform</p>
      </div>

      <% if (error) { %>
        <div class="alert alert-error"><span>⚠</span>
          <%= error %>
        </div>
        <% } %>

          <form action="/login" method="POST" class="auth-form">
            <div class="role-toggle">
              <label class="role-btn">
                <input type="radio" name="role" value="user" checked>
                <span class="role-label"><span class="role-icon">💬</span> User</span>
              </label>
              <label class="role-btn">
                <input type="radio" name="role" value="admin">
                <span class="role-label"><span class="role-icon">🛡</span> Admin</span>
              </label>
            </div>

            <div class="form-group">
              <label for="username">Username</label>
              <input type="text" id="username" name="username" placeholder="Enter username" autocomplete="username"
                required />
            </div>

            <div class="form-group">
              <label for="password">Password</label>
              <input type="password" id="password" name="password" placeholder="Enter password"
                autocomplete="current-password" required />
            </div>

            <button type="submit" class="btn-primary btn-full">Sign In →</button>
          </form>

          <div class="auth-hint">
            <p><strong>User:</strong> user / user123 &nbsp;|&nbsp; <strong>Admin:</strong> admin / admin123</p>
          </div>
    </div>
  </div>
  <script src="/js/login.js"></script>
</body>

</html>